# Copie este arquivo para ".env" e preencha os valores.

# Endereço do banco PostgreSQL (Render, Neon, Supabase ou o seu próprio).
# Use um usuário COMUM do banco (não superusuário) para o isolamento entre restaurantes funcionar no próprio banco.
DATABASE_URL=postgres://usuario:senha@host:5432/cardapio

# SSL: o servidor decide sozinho (liga para endereços externos, desliga para localhost e rede interna do Render).
# Para forçar, use DATABASE_SSL=true ou DATABASE_SSL=false.
# DATABASE_SSL=true

# Frase longa e aleatória usada para proteger os logins. Nunca compartilhe.
JWT_SECRET=troque-por-uma-frase-longa-e-aleatoria

# Endereço público do site (sem barra no final). Usado nos links que os scripts mostram.
PUBLIC_URL=http://localhost:3000

PORT=3000

# Contato do suporte mostrado em "Esqueci minha senha" (opcional)
# SUPORTE_WHATSAPP=5515999990000
# SUPORTE_EMAIL=suporte@seusite.com.br

# Pagamento pelo site (entrega): "demo" = tela de demonstração que não cobra nada (padrão); "off" = desligado.
# Quando escolherem a empresa de pagamento, ela ganha um nome aqui (ex.: mercadopago) e as chaves dela.
# PAGAMENTO_PROVEDOR=demo

# Contas de cliente (só para pagar a entrega pelo site). "off" desliga contas e pagamento pelo site.
# CLIENTE_CONTAS=off

# Avisos automáticos no WhatsApp (API oficial da Meta). Vazio = desligado; "log" = só no log do servidor; "meta" = envia.
# WHATSAPP_PROVEDOR=meta
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_MODELO=status_pedido

# Primeiro acesso de dev criado pelo "npm run seed" quando ainda não há nenhum (mínimo 10 caracteres)
# ADMIN_INICIAL_EMAIL=voce@email.com
# ADMIN_INICIAL_SENHA=umaSenhaBemForte

# Restaurante mostrado na página inicial (/) do site. Os outros ficam em /r/<endereço>.
# SITE_RESTAURANTE=sabor-da-casa

# Nota fiscal (NFC-e): demo (simula, sem valor fiscal), focusnfe (emissão real) ou off
FISCAL_PROVEDOR=demo
# Busca de endereço para a taxa por distância (OpenStreetMap). off = o cliente só marca no mapa
BUSCA_ENDERECO=on
# Contato enviado ao OpenStreetMap junto com as buscas (pedido pela política de uso deles)
BUSCA_ENDERECO_CONTATO=

# ---------- E-mail ("Esqueci minha senha" e faturas da mensalidade) ----------
# Endereço do site, usado nos links dos e-mails (no Render, se faltar, usa o endereço do serviço)
# PUBLIC_URL=https://cardapio-serv.onrender.com
# resend (recomendado), smtp ou off. Em produção, sem isso, o envio fica desligado.
# EMAIL_PROVEDOR=resend
# RESEND_API_KEY=
# EMAIL_REMETENTE=Cardápio <nao-responda@seudominio.com.br>
# SMTP_HOST=  SMTP_PORTA=587  SMTP_USUARIO=  SMTP_SENHA=

# ---------- Termos de uso e privacidade ----------
# PLATAFORMA_NOME=Cardápio Digital
# PLATAFORMA_RAZAO_SOCIAL=Sua Empresa Ltda
# PLATAFORMA_CNPJ=00000000000000
# PLATAFORMA_CIDADE=Sorocaba (SP)
# PRIVACIDADE_EMAIL=privacidade@seudominio.com.br

# ---------- Pix automático (cada restaurante cola o token dele no painel) ----------
# Mostra a opção "Demonstração" (botão Simular pagamento). Em produção vem desligado: use on só no site de apresentação.
# PIX_DEMO=on

# ---------- Mensalidade dos restaurantes (Pix na conta da plataforma) ----------
# mercadopago, demo (só apresentação) ou off (padrão em produção: só baixa manual)
# COBRANCA_PROVEDOR=mercadopago
# COBRANCA_MP_TOKEN=APP_USR-...
# COBRANCA_MP_SEGREDO=
# COBRANCA_EMAIL_PAGADOR=financeiro@seudominio.com.br

# ---------- Lembrete de carrinho (modelo do WhatsApp aprovado na Meta) ----------
# WHATSAPP_MODELO_CARRINHO=lembrete_carrinho

# ---------- Importar cardápio por foto (IA da Anthropic) ----------
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODELO=claude-sonnet-5

# ---------- Domínio próprio dos restaurantes ----------
# Endereço para onde o CNAME dos restaurantes aponta (usado no "Verificar DNS")
# DOMINIO_ALVO=cardapio-serv.onrender.com
